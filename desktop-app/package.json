{
  "name": "companysync-desktop",
  "productName": "CompanySync",
  "version": "1.0.0",
  "description": "CompanySync desktop client: two-way folder sync with a Cloudflare R2-backed team workspace.",
  "main": "src/main/main.js",
  "author": "CompanySync",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "check": "node -e \"for (const f of require('fs').readdirSync('src/main')) require('child_process').execFileSync(process.execPath, ['--check', 'src/main/' + f], { stdio: 'inherit' })\" && node --check src/preload/preload.js && node --check src/renderer/i18n.js && node --check src/renderer/app.js"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.companysync.desktop",
    "productName": "CompanySync",
    "copyright": "Copyright © CompanySync",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "CompanySync-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CompanySync",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "CompanySync-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "CompanySync-${version}.${ext}"
    }
  }
}
