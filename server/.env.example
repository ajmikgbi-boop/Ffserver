# Copy to .env for local development (Render reads these from the dashboard instead).

# Port to listen on. Render injects PORT automatically; 3000 is used locally.
PORT=3000

# Cloudflare R2 credentials (R2 > Manage R2 API Tokens > Create API token, "Object Read & Write").
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=companysync

# ---------------------------------------------------------------------------
# Optional settings (sensible defaults are used when these are not set)
# ---------------------------------------------------------------------------

# Override the S3 endpoint, e.g. for EU-jurisdiction buckets:
#   https://<account-id>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=

# Comma-separated list of Server Codes this server accepts. Leave empty to accept any
# well-formed code. Strongly recommended for public deployments so strangers cannot
# use your bucket.
# ALLOWED_SERVER_CODES=acme-hq,acme-design

# Express "trust proxy" setting (1 = trust the first proxy hop, i.e. Render's router).
# TRUST_PROXY=1

# Lifetime of presigned upload/download URLs in seconds (default 3600).
# PRESIGN_EXPIRES_SECONDS=3600

# Files at least this large use multipart uploads (default 104857600 = 100 MiB).
# MULTIPART_THRESHOLD_BYTES=104857600

# Multipart part size in bytes (default 16777216 = 16 MiB, minimum 5 MiB).
# MULTIPART_PART_SIZE_BYTES=16777216

# debug | info | warn | error
# LOG_LEVEL=info
